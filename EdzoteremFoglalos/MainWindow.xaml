<Window x:Class="EdzoteremFoglalos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EdzoteremFoglalos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Név:"/>
        <TextBox x:Name="nameTextBox" Margin="0,5,0,10"/>

        <TextBlock Text="Időpont:"/>
        <TextBox x:Name="timeTextBox" Margin="0,5,0,10"/>

        <CheckBox x:Name="teamCheckBox"
                  Content="Csoportos foglalás"
                  Margin="0,0,0,10"/>

        <TextBlock Text="Csapattagok nevei vesszővel elválasztva:"/>
        <TextBox x:Name="membersTextBox" Margin="0,5,0,10"/>

        <Button Content="Foglalás"
                Click="Button_Click"
                Height="30"
                Margin="0,0,0,15"/>

        <TextBlock Text="Idősávok:"
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="10:00" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="time10TextBlock"
                               Text="Szabad"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="12:00" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="time12TextBlock"
                               Text="Szabad"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="14:00" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="time14TextBlock"
                               Text="Szabad"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="16:00" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="time16TextBlock"
                               Text="Szabad"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" BorderBrush="Black" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="18:00" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="time18TextBlock"
                               Text="Szabad"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Window>
